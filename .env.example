# Copy to .env and fill in real values. .env is git-ignored; this file is not.
#   cp .env.example .env

# records_db: the simulated Student Records System (port 5433)
RECORDS_DB_USER=records_admin
RECORDS_DB_PASSWORD=change-me
RECORDS_DB_NAME=records_db
RECORDS_DB_URL=postgresql://records_admin:change-me@localhost:5433/records_db

# app_db: owned by SQLibrarian (port 5434)
APP_DB_USER=app_admin
APP_DB_PASSWORD=change-me
APP_DB_NAME=app_db
APP_DB_URL=postgresql://app_admin:change-me@localhost:5434/app_db

# Groq free tier, used only by training/generate_pairs.py and rewrite_arabic.py
GROQ_API_KEY=

# MLflow on DagsHub (training and baseline runs): repo page > Remote > Experiments
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub user>
MLFLOW_TRACKING_PASSWORD=<dagshub token>

# --- Optional: everything below has a default in src/sqlibrarian/config.py -----------
# Override here only to change it without touching code.
# BASE_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct
# PAIR_GENERATOR_MODEL=openai/gpt-oss-120b
# PAIR_GENERATOR_BASE_URL=https://api.groq.com/openai/v1
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# MAX_TRAIN_TOKENS=2048
# STATEMENT_TIMEOUT=3s
# GROQ_MAX_CALLS_PER_DAY=30
# GROQ_WAIT_SECONDS=45
# DECONTAMINATION_THRESHOLD=0.9
# LOG_LEVEL=INFO
# LOG_FORMAT=console        # or json
